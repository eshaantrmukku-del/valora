{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist/web",
  "installCommand": "npm ci",
  "framework": null,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://REPLACE-WITH-YOUR-BACKEND.onrender.com/api/:path*" },
    { "source": "/((?!assets/|valora-logo).*)", "destination": "/index.html" }
  ]
}
