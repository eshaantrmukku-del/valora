# Optional vision API keys (server-side only — never commit real keys)
# Used by /api/vision to classify kitchen/bathroom/etc from listing photos.
# Without a key, Valora falls back to a low-confidence visual heuristic.

# OPENAI_API_KEY=sk-...
# OPENAI_VISION_MODEL=gpt-4o-mini

# GROQ_API_KEY=gsk_...
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# GEMINI_API_KEY=...
