# Valora environment variables. Copy to .env for local development. NEVER commit real values.

# --- Core ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
DATABASE_URL=postgres://valora:valora@localhost:5432/valora
# Set to true for managed Postgres that requires TLS (e.g. some hosted providers)
DATABASE_SSL=false
# Run the background worker (searches, monitoring, AI narratives) inside the web process
RUN_WORKER=true
MIGRATE_ON_START=false
LOG_LEVEL=info

# --- AI (optional; without it Valora uses its rule-based parser and shows no AI narrative) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_DAILY_CALL_LIMIT=200

# --- Live listing + rental data (PropertyData, paid API) ---
PROPERTYDATA_API_KEY=
PROPERTYDATA_LISTS=unmodernised-properties,reduced-properties,repossessed-properties,quick-sale-properties

# --- EPC register (free registration) ---
EPC_API_EMAIL=
EPC_API_KEY=

# --- Open data (no keys needed) ---
ENABLE_LAND_REGISTRY=true
ENABLE_POSTCODES_IO=true
ENABLE_PLANNING_DATA=true

# --- Email (Resend) for alerts and password reset ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Test-only switches (refused when NODE_ENV=production) ---
ENABLE_FIXTURE_PROVIDER=false
ENABLE_FAKE_AI=false
